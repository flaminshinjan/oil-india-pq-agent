# ---- Secrets (must never be committed) ----
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
backend/.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Vector store (derived; regenerate with `python -m app.retrieval.ingest --reset`) ----
backend/chroma_db/

# ---- Runtime caches / shared-context store (created on first boot) ----
backend/atlas_cache/
backend/atlas_signals.sqlite
backend/atlas_signals.sqlite-journal

# ---- Reference design (not part of the deployed product) ----
oil india/

# ---- Node / Next.js ----
node_modules/
.next/
out/
.npm/

# ---- TypeScript ----
*.tsbuildinfo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- OS / editor / agent state ----
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
*~

# ---- Office temp files (Word/Excel lock files) ----
~$*
~WRL*.tmp
*.tmp

# ---- Local scratch ----
/tmp_*
*.local

# ---- Heavy corpus assets ----
# The PDF versions of PQ replies are mostly scanned images of the
# corresponding .docx files. The agent uses the .docx (real text) so the
# PDFs are redundant. Keeping them out keeps the repo small (~27 MB
# instead of ~410 MB).
Parliamentary Replies/**/*.pdf

# "Oil Web Data Files/" is the raw drop of annual / BRSR / ESG PDFs.
# The deployable copy lives at `backend/sources/`, which IS committed so
# the Docker build can ship the citation-preview corpus. Don't duplicate
# the 75 MB in the repo root.
Oil Web Data Files/
